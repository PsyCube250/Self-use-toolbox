    5.发问
      from transformers import AutoModelForCausalLM, AutoTokenizer
      from peft import PeftModel
      import torch
      
      base_model_path = "/root/models/Qwen3-1.7B-Base"
      lora_path = f"/root/saves/qwen3-1.7b-persona-lora-v{N}"
      
      tokenizer = AutoTokenizer.from_pretrained(base_model_path, trust_remote_code=True)
      model = AutoModelForCausalLM.from_pretrained(base_model_path, dtype=torch.bfloat16, device_map="cuda", trust_remote_code=True)
      model = PeftModel.from_pretrained(model, lora_path)
      model.eval()
      
      def chat(prompt, history=None):
          if history is None:
              history = []
          messages = history + [{"role": "user", "content": prompt}]
          text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
          inputs = tokenizer(text, return_tensors="pt").to("cuda")
          outputs = model.generate(
              **inputs,
              max_new_tokens=60,
              temperature=0.6,
              top_p=0.85,
              repetition_penalty=1.3,
              no_repeat_ngram_size=3,
              do_sample=True,
          )
          response = tokenizer.decode(outputs[0][inputs.input_ids.shape[1]:], skip_special_tokens=True)
          print("回复:", response)
          return response
      
      # 每轮建议固定用同一组测试问题，方便跨版本横向对比效果
      test_prompts = ["在干嘛呢", "这个周末有空吗", "作业写完了吗", "晚上一起吃饭吗"]
      for p in test_prompts:
          print(f"\n问: {p}")
          chat(p)

