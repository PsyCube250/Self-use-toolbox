import json
import re


def parse_json_safely(text):
    text = str(text).strip()

    # 去除 ```json ... ``` 包裹
    text = re.sub(
        r"^```(?:json)?\s*|\s*```$",
        "",
        text,
        flags=re.IGNORECASE
    ).strip()

    try:
        return json.loads(text)

    except json.JSONDecodeError:
        # 尝试从额外文字中提取 JSON 对象
        match = re.search(
            r"\{.*\}",
            text,
            flags=re.DOTALL
        )

        if match:
            return json.loads(match.group(0))

        raise


