def build_memory_context(
    query,
    retrieve_k=6,
    max_memories=2
):
    results = retrieve(
        query,
        top_k=retrieve_k,
        min_score=None
    )

    selected = results[:max_memories]
    blocks = []

    for rank, item in enumerate(
        selected,
        start=1
    ):
        block = f"""[真实记忆 {rank}]
维度：{item.get("dimension", "")}
问题：{truncate_text(item.get("question", ""), 250)}
回答：{truncate_text(item.get("answer", ""), 600)}"""

        blocks.append(block)

    context = "\n\n".join(blocks)

    return context, selected

#newpersona_chat
def persona_chat(
    user_message,
    history=None,
    temperature=0.7,
    max_tokens=256,
    debug=True
):
    if history is None:
        history = []

    # 第一阶段：让模型决定是否需要长期记忆
    routing = decide_memory_usage(
        user_message=user_message,
        history=history
    )

    memory_context = ""
    retrieved = []

    # 第二阶段：只有模型判断需要时才检索
    if routing["need_memory"]:
        search_query = (
            routing["search_query"]
            or user_message
        )

        memory_context, retrieved = (
            build_memory_context(
                query=search_query,
                retrieve_k=6,
                max_memories=2
            )
        )

    system_content = PERSONA_SYSTEM_PROMPT

    # 只有真正检索到记忆时才加入
    if memory_context:
        system_content += (
            "\n\n以下是与当前问题相关的真实记忆：\n\n"
            + memory_context
        )

    messages = [
        {
            "role": "system",
            "content": system_content
        },
        *history,
        {
            "role": "user",
            "content": user_message
        }
    ]

    # 第三阶段：最终人格回答
    answer = call_persona_model(
        messages=messages,
        temperature=temperature,
        top_p=0.8,
        max_tokens=max_tokens
    )

    result = {
        "answer": answer,
        "routing": routing,
        "rag_requested": routing["need_memory"],
        "rag_used": bool(memory_context),
        "retrieved": retrieved,
        "messages": messages
    }

    if debug:
        print("模型回答：")
        print(answer)

        print("\n路由判断：")
        print(
            "需要记忆：",
            routing["need_memory"]
        )
        print(
            "检索问题：",
            routing["search_query"]
        )
        print(
            "路由解析成功：",
            routing["parse_success"]
        )
        print(
            "最终注入记忆：",
            bool(memory_context)
        )

        if not routing["parse_success"]:
            print(
                "路由原始输出：",
                routing["raw_output"]
            )
            print(
                "路由错误：",
                routing.get("error", "")
            )

        for rank, item in enumerate(
            retrieved,
            start=1
        ):
            print("=" * 70)
            print("记忆排名：", rank)
            print(
                "相似度：",
                round(item["score"], 4)
            )
            print(
                "维度：",
                item.get("dimension", "")
            )
            print(
                "问题：",
                item.get("question", "")
            )

    return result



