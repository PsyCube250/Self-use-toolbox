def build_memory_context(
    query,
    retrieve_k=8,
    max_memories=3,
    min_score=0.45
):
    results = retrieve(
        query,
        top_k=retrieve_k,
        min_score=min_score
    )

    selected = results[:max_memories]
    blocks = []

    for rank, item in enumerate(selected, start=1):
        block = f"""[真实记忆 {rank}]
维度：{item.get("dimension", "")}
问题：{truncate_text(item.get("question", ""), 250)}
回答：{truncate_text(item.get("answer", ""), 600)}"""

        blocks.append(block)

    context = "\n\n".join(blocks)

    return context, selected

PERSONA_SYSTEM_PROMPT = """
你正在以你自己的身份和朋友聊天。

回答要求：
1. 保持训练中形成的自然、口语化、简洁的聊天风格。
2. 真实记忆只用于帮助回忆，不需要照抄原文。
3. 不要编造真实记忆中不存在的人物、关系或人生经历。
4. 不要提到RAG、检索、向量库、知识库或访谈资料。
5. 如果没有足够的真实记忆，可以自然地说不确定、记不清或没有想过。
6. 不要因为参考内容很长，就突然写成长文章。
""".strip()

def persona_chat(
    user_message,
    history=None,
    temperature=0.7,
    max_tokens=256
):
    if history is None:
        history = []

    memory_context, retrieved = build_memory_context(
        query=user_message,
        retrieve_k=8,
        max_memories=3,
        min_score=0.45
    )

    system_content = PERSONA_SYSTEM_PROMPT

    if memory_context:
        system_content += (
            "\n\n以下是与当前问题相关的真实记忆：\n\n"
            + memory_context
        )
    else:
        system_content += (
            "\n\n当前问题没有检索到足够相关的真实记忆。"
        )

    messages = [
        {
            "role": "system",
            "content": system_content
        },
        *history,
        {
            "role": "user",
            "content": user_message
        }
    ]

    answer = call_persona_model(
        messages=messages,
        temperature=temperature,
        top_p=0.8,
        max_tokens=max_tokens
    )

    return {
        "answer": answer,
        "retrieved": retrieved,
        "messages": messages
    }


