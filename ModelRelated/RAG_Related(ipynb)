#decide_memory_usage()
def decide_memory_usage(
    user_message,
    history=None
):
    if history is None:
        history = []

    # 只提供最近两轮对话，避免路由输入过长
    recent_history = history[-4:]

    messages = [
        {
            "role": "system",
            "content": MEMORY_ROUTER_PROMPT
        },
        *recent_history,
        {
            "role": "user",
            "content": user_message
        }
    ]

    raw_output = call_persona_model(
        messages=messages,
        temperature=0.0,
        top_p=1.0,
        max_tokens=100
    )

    try:
        decision = parse_json_safely(raw_output)

        if not isinstance(decision, dict):
            raise ValueError(
                "路由模型返回的不是JSON对象"
            )

        need_memory = decision.get(
            "need_memory",
            False
        )

        # 兼容 "true" 和 "false" 字符串
        if isinstance(need_memory, str):
            need_memory = (
                need_memory.strip().lower() == "true"
            )

        search_query = str(
            decision.get("search_query", "")
        ).strip()

        if not need_memory:
            search_query = ""

        return {
            "need_memory": bool(need_memory),
            "search_query": search_query,
            "raw_output": raw_output,
            "parse_success": True
        }

    except Exception as error:
        # 路由解析失败时默认不注入记忆，避免污染回答
        return {
            "need_memory": False,
            "search_query": "",
            "raw_output": raw_output,
            "parse_success": False,
            "error": str(error)
        }


